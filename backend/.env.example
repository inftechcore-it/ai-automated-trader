PORT=5000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Main Trading Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trading_system

# Prisma Database URL (for arbitrage module)
DATABASE_URL="mysql://user:password@localhost:3306/arbitrage_trading"

JWT_SECRET=change_this_to_a_long_random_value
ENCRYPTION_KEY=change_this_to_32_bytes_minimum

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
BINANCE_BASE_URL=https://api.binance.com
KRAKEN_BASE_URL=https://api.kraken.com

# Binance API (for arbitrage trading)
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Bybit API (optional)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Kraken API (optional)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Pionex API (crypto trading with built-in bots)
PIONEX_API_KEY=your_pionex_api_key
PIONEX_API_SECRET=your_pionex_api_secret

# Use testnet or mainnet
USE_TESTNET=true

# Arbitrage Scanner Configuration
SCAN_INTERVAL_MS=500
MIN_PROFIT_THRESHOLD_PERCENT=0.01
TOP_N_ASSETS=30
FEE_RATE_DEFAULT=0.001

# Redis (optional - scanner works without it)
REDIS_URL=redis://localhost:6379

# Upstox API (Indian Stock Exchanges - NSE/BSE)
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=http://localhost:5000/api/upstox/callback

# Google Gemini AI (for AI-powered trading analysis)
GEMINI_API_KEY=your_gemini_api_key
