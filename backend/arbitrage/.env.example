# Database (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://erpuser:erpdb@98.130.107.169:3306/arbitrage_trading"

# Encryption key for API credentials (min 16 chars)
ENCRYPTION_KEY="your-secure-encryption-key-here"

# Exchange API Keys (for testnet)
BINANCE_API_KEY="your-binance-testnet-api-key"
BINANCE_API_SECRET="your-binance-testnet-api-secret"

BYBIT_API_KEY="your-bybit-testnet-api-key"
BYBIT_API_SECRET="your-bybit-testnet-api-secret"

# Use testnet by default (set to "false" for mainnet)
USE_TESTNET=true

# Scanner Configuration
SCAN_INTERVAL_MS=500
MIN_PROFIT_THRESHOLD_PERCENT=0.1
TOP_N_ASSETS=30
FEE_RATE_DEFAULT=0.001

# Redis (optional - scanner works without it)
REDIS_URL=redis://localhost:6379
