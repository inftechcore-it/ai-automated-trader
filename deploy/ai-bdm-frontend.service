[Unit]
Description=AI-BDM Trading Frontend (Vite Dev Server)
Documentation=https://github.com/your-repo/ai-bdm
After=network.target ai-bdm-backend.service
Wants=ai-bdm-backend.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ai-bdm/frontend
Environment=NODE_ENV=production

# For production: serve built files
ExecStart=/usr/bin/npx serve -s dist -l 5173

# For development: use vite dev server
# ExecStart=/usr/bin/npm run dev -- --host 0.0.0.0

ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/ai-bdm/frontend.log
StandardError=append:/var/log/ai-bdm/frontend-error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
