[Unit]
Description=AI-BDM Trading Backend API
Documentation=https://github.com/your-repo/ai-bdm
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ai-bdm/backend
Environment=NODE_ENV=production
Environment=PORT=5000
EnvironmentFile=/var/www/ai-bdm/backend/.env

# Pre-start: ensure prisma client is generated
ExecStartPre=/usr/bin/npx prisma generate --schema=prisma/schema.prisma

ExecStart=/usr/bin/node server.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/ai-bdm/backend.log
StandardError=append:/var/log/ai-bdm/backend-error.log

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65535
MemoryMax=1G

[Install]
WantedBy=multi-user.target
